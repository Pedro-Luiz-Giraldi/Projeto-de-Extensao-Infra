all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: "~/.ssh/${app_key_name}.pem"
    ssh_host_key_options: "-o StrictHostKeyChecking=accept-new"

  children:
    web_servers:
      vars: 
        ansible_ssh_common_args: >- 
          {{ ssh_host_key_options }}
      hosts:
        web_server_01:
          ansible_host: ${web_server_01_public_ip}
        web_server_02:
          ansible_host: ${web_server_02_public_ip}

    app_servers:
      vars:
        ansible_ssh_common_args: >-
          {{ ssh_host_key_options }}
          -o ProxyCommand='ssh -i ~/.ssh/${app_key_name}.pem -W %h:%p ubuntu@${web_server_01_public_ip}'
      hosts:
        app_server_01:
          ansible_host: ${backend_01_private_ip}
        app_server_02:
          ansible_host: ${backend_02_private_ip}
